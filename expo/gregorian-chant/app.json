{
  "expo": {
    "name": "Gregorian Chant",
    "slug": "gregorian-chant",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gregorianchant",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
