{
  "expo": {
    "name": "Habits",
    "slug": "habits",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "habits",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
